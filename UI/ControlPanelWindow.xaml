<Window x:Class="MonitorAltTab.UI.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alt Tab Canavarı - Kontrol Paneli"
        Width="780" Height="680"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Roboto, sans-serif"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#131B2E"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Checkbox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area (Scrollable) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Mascot Logo -->
            <Border Grid.Column="0" Width="68" Height="68" CornerRadius="16" Margin="0,0,16,0" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#8B5CF6" Opacity="0.5"/>
                </Border.Effect>
                <Image Source="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill" Margin="2">
                    <Image.Clip>
                        <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,64,64"/>
                    </Image.Clip>
                </Image>
            </Border>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ALT TAB CANAVARI" FontSize="22" FontWeight="Black" Foreground="#FFFFFF"/>
                    <Border Background="#312E81" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.1.0" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Çoklu Monitör Akıllı Pencere Yöneticisi" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status Pill -->
            <Border Grid.Column="2" x:Name="StatusBadge" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="ÇALIŞIYOR" FontSize="12" FontWeight="Bold" Foreground="#6EE7B7"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Scrollable Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>

                <!-- Live Monitor Status Card -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="🖥️" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="CANLI EKRAN VE MONİTÖR DURUMU" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Fare imleciniz hangi monitördeyse, Alt+Tab sadece o monitördeki pencereleri açar." FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,12"/>

                        <!-- Monitors List Container -->
                        <ItemsControl Grid.Row="2" x:Name="MonitorsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="12,10" Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Monitor Icon & Indicator -->
                                            <TextBlock Grid.Column="0" Text="{Binding IconSymbol}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <!-- Monitor Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                                                    <TextBlock Text="{Binding ResolutionText}" FontSize="12" Foreground="#64748B" Margin="8,0,0,0"/>
                                                    <Border Visibility="{Binding PrimaryBadgeVisibility}" Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="8,0,0,0">
                                                        <TextBlock Text="Ana Ekran" FontSize="10" Foreground="#94A3B8"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ActiveWindowsText}" FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Cursor Active Badge -->
                                            <Border Grid.Column="2" Visibility="{Binding CursorHereBadgeVisibility}" Background="#0369A1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="📍 Fare Burada" FontSize="11" FontWeight="Bold" Foreground="#E0F2FE"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Settings Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="UYGULAMA AYARLARI" FontSize="13" FontWeight="Bold" Foreground="#A78BFA"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkEnableHook" Content="Alt Tab Canavarı Aktif (Özel Alt+Tab devrede)" IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="ChkAutoStart" Content="Windows açılışında otomatik olarak çalıştır" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Kapat (X) butonuna basıldığında uygulamayı kapatma, sistem tepsisine gizle" IsChecked="True" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="ChkStartMinimized" Content="Uygulama açılırken bu pencereyi gizle (doğrudan sistem tepsisinde sessizce çalış)" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </StackPanel>
                </Border>

                <!-- Shortcuts Cheatsheet Card -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⌨️" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="KISAYOLLAR VE KULLANIM" FontSize="13" FontWeight="Bold" Foreground="#34D399"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="• Alt + Tab: Sıradaki pencereye geç" Foreground="#CBD5E1" FontSize="12.5" Margin="0,3"/>
                                <TextBlock Text="• Alt + Shift + Tab: Önceki pencereye dön" Foreground="#CBD5E1" FontSize="12.5" Margin="0,3"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="• Fare Tıklaması: Listeden istediğine tıkla" Foreground="#CBD5E1" FontSize="12.5" Margin="0,3"/>
                                <TextBlock Text="• Escape (Esc): Seçimi iptal et" Foreground="#CBD5E1" FontSize="12.5" Margin="0,3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Certificate & SmartScreen Trust Card -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="DİJİTAL SERTİFİKA VE GÜVENLİK" FontSize="13" FontWeight="Bold" Foreground="#F59E0B"/>
                            </StackPanel>
                            <TextBlock Text="Windows SmartScreen uyarısını tamamen kaldırmak için 'Alt Tab Canavarı' sertifikasını tek tıkla güvenilen yayıncılara ekleyebilirsiniz." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Sertifikayı Yükle" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnInstallCert_Click"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🧪 Önizlemeyi Test Et" Style="{StaticResource SecondaryButton}" Click="BtnTestOverlay_Click"/>

                <Button Grid.Column="2" Content="⬇️ Tepsiye Küçült" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BtnMinimizeToTray_Click"/>

                <Button Grid.Column="3" Content="Çıkış" Style="{StaticResource SecondaryButton}" Click="BtnExit_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
